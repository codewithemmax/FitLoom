{
  "manifest_version": 3,
  "name": "FitLoom Try-On MVP",
  "description": "Detect a supported garment, confirm it, and request a safe FitLoom try-on.",
  "version": "0.1.0",
  "icons": {
    "16": "src/icon-16.png",
    "32": "src/icon-32.png",
    "48": "src/icon-48.png",
    "128": "src/icon-128.png"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "FitLoom",
    "default_icon": {
      "16": "src/icon-16.png",
      "32": "src/icon-32.png",
      "48": "src/icon-48.png",
      "128": "src/icon-128.png"
    }
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"]
}
